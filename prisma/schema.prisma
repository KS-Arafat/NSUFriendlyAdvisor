generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./tmp/sqlite.db"
}

model User {
  id          String @id @default(uuid())
  u_email     String @unique
  u_pwd       String
  rds_id      String @unique
  rds_pwd     String
  priority    String
  CourseCount Int
}

model CoursePool {
  course_name    String @unique
  available_seat Int
  student_inneed Int
}
